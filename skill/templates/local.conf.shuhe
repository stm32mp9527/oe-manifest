#     ${TF_A_CONFIG_BASENAME_BIN},\
#     ${TF_A_CONFIG_MAKE_TARGET},\
#     ${TF_A_CONFIG_DEPLOY_FTYPE} ${TF_A_CONFIG_DEPLOY_EXTRA},\
#     ${EXTDT_SUFFIX_SDCARD}"
